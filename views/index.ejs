<!DOCTYPE html>
<html lang="en">
  <%- include("./partials/head", {title:title}) %>
  <body>
    <%- include("./partials/header", {title:title}) %>
    <a href="/new">Write new message</a>
    <div class="messageBlock">
      <% if (messages.length === 0) { %>
      <h3>No messages yet...</h3>
      <% }; %>
      <% messages.forEach((message)=>{ %>
      <div class="message">
        <h3 class="user"><%= message.username %></h3>
        <span class="messageText"><%= message.text %></span>
        <small class="date"> Posted on <%= message.added %> </small>
      </div>
      <% }) %>
    </div>
    <details>
      <summary>DELETE all messages</summary>
      <form class="delete-form" action="/delete" method="POST">
        <label for="confirmDelete">Are you sure?</label>
        <input
          type="text"
          id="confirmDelete"
          name="confirmDelete"
          placeholder="Type 'confirm' to delete"
          required
        />
        <button type="submit">Submit</button>
      </form>
    </details>
    <%- include("./partials/footer") %>
  </body>
</html>
